generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model Form {
  id         String   @id @default(uuid()) @db.Uuid
  barberName String
  clientName String
  phoneNumber String?
  time       DateTime
  service    String
  createdAt  DateTime @default(now())
}